@using Ogani.Business.Dtos.ContactDtos
@model ContactDto


<div class="container mt-4">
    <div class="row">
      
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h3 class="card-title">@Model.Name</h3>
                    <h3 class="card-title">@Model.Email</h3>
                    <p class="card-text"><strong>Message:</strong> @Model.Message</p>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <a href="/Admin/Contact/Index" class="btn btn-secondary">Back</a>
    </div>
</div>
