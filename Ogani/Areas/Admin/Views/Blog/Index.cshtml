@using Ogani.Business.Dtos.BlogDtos
@model List<BlogDto>

<div class="card">
    <h5 class="card-header">Categories</h5>
    <div class="table-responsive text-nowrap">
        <a asp-controller="Blog" asp-action="create" type="submit" class="btn btn-primary">Create</a>

        <table class="table table-dark">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Image</th>
                    <th>Title</th>
                    <th>Update</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var category in Model)
                {
                    <tr>
                        <td><i class="fab fa-angular fa-lg text-danger me-3"></i> <strong>@category.Id</strong></td>
                        <td>
                            <img src="@category.ImageUrl" width="100px" alt="Alternate Text" />
                        </td>
                        <td>@category.Title</td>
                        <td><a asp-controller="Blog" asp-action="Update" asp-route-id="@category.Id" class="badge bg-label-primary me-1">Update</a></td>
                        <td>
                            <a asp-controller="Blog" asp-action="Delete" asp-route-id="@category.Id" class="badge bg-label-primary me-1">Delete</a>
                        </td>
                    </tr>

                }

            </tbody>
        </table>
    </div>
</div>