@model List<CategoryDto>

<div class="card">
    <h5 class="card-header">Categories</h5>
    <div class="table-responsive text-nowrap">
        <table class="table table-dark">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Image</th>
                    <th>Update</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var category in Model)
                {
                    <tr>
                        <td><i class="fab fa-angular fa-lg text-danger me-3"></i> <strong>@category.Id</strong></td>
                        <td>@category.Name</td>
                        <td>
                           <img src="~/img/categories/@category.ImageUrl" width="100px" alt="Alternate Text" />
                        </td>
                        <td><button class="badge bg-label-primary me-1">Update</button></td>
                        <td>
                            <button class="badge bg-label-primary me-1">Delete</button>
                        </td>
                    </tr>

                }
               
            </tbody>
        </table>
    </div>
</div>