@model ProductDto

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <img src="@Model.IsMainPicture" class="card-img-top" alt="@Model.Name" style="max-height: 350px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title text-center">ProductImages</h5>
                    <div class="d-flex flex-wrap justify-content-center">
                        @foreach (var img in Model.ProductImages ?? [])
                        {
                            <img src="@img.ImageUrl" class="img-thumbnail m-1" width="100px" height="100px" />
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h3 class="card-title">@Model.Name</h3>
                    <p class="card-text"><strong>Description:</strong> @Model.Description</p>
                    <p class="card-text"><strong>Price:</strong> $@Model.Price</p>
                    <p class="card-text">
                        <strong>Category:</strong>
                        <strong>@Model.CategoryName</strong>
                         
                    </p>

                    

                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <a href="/Admin/Product/Index" class="btn btn-secondary">Back</a>
    </div>
</div>
