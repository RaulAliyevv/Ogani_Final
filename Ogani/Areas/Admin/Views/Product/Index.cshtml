@model List<ProductDto>

<div class="card">
    <h5 class="card-header">Categories</h5>
    <div class="table-responsive text-nowrap">
        <a asp-controller="category" asp-action="create" type="submit" class="btn btn-primary">Create</a>

        <table class="table table-dark">
            <thead>
                <tr>
                    <th>Main image</th>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Update</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var productDto in Model)
                {
                    <tr>
                        <td>
                            <img src="@productDto.IsMainPicture" width="100px" alt="Alternate Text" />
                        </td>
                        <td><i class="fab fa-angular fa-lg text-danger me-3"></i> <strong>@productDto.Id</strong></td>
                        <td>@productDto.Name</td>
                        <td>@productDto.Price</td>
                        <td><a asp-controller="Category" asp-action="Update" asp-route-id="@productDto.Id" class="badge bg-label-primary me-1">Update</a></td>
                        <td>
                            <a asp-controller="Category" asp-action="Delete" asp-route-id="@productDto.Id" class="badge bg-label-primary me-1">Delete</a>
                        </td>
                    </tr>

                }

            </tbody>
        </table>
    </div>
</div>