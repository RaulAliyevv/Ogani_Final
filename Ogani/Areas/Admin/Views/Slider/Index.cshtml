@using Ogani.Business.Dtos.SliderDtos
@model List<SliderDto>
<div class="card">
    <h5 class="card-header">Slider</h5>
    <div class="table-responsive text-nowrap">
        @* <a asp-controller="category" asp-action="create" type="submit" class="btn btn-primary">Create</a> *@

        <table class="table table-dark">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Image</th>
                    <th>Update</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var slider in Model)
                {
                    <tr>
                        <td><i class="fab fa-angular fa-lg text-danger me-3"></i> <strong>@slider.Id</strong></td>
                        <td>@slider.Name</td>
                        <td>
                            <img src="@slider.ImgUrl" width="100px" alt="Alternate Text" />
                        </td>
                        <td><a asp-controller="Slider" asp-action="Update" asp-route-id="@slider.Id" class="badge bg-label-primary me-1">Update</a></td>
                     
                    </tr>

                }


            </tbody>
        </table>
    </div>
</div>