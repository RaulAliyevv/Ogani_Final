@using Ogani.Business.Dtos.HomeDtos
@model DetailDto

<section class="product-details spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-6">
                <div class="product__details__pic">
                    <div class="product__details__pic__item">
                        <img class="product__details__pic__item--large"
                             src="@Model.Product.IsMainPicture" alt="">
                    </div>
                    <div class="product__details__pic__slider owl-carousel">
                        @foreach (var img in Model.Product.ProductImages)
                        {
                            <img data-imgbigurl="@img.ImageUrl"
                                 src="@img.ImageUrl" alt="">
                        }


                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-6">
                <div class="product__details__text">
                    <h3>@Model.Product.Name</h3>
                   
                    <div class="product__details__price">$@Model.Product.Price</div>
                    <p>
                      @Model.Product.Description
                    </p>
                    
                    <a href="javascript:void(0);" onclick="addToBasket(@Model.Id)" class="primary-btn">ADD TO CARD</a>
                    <a href="javascript:void(0);" onclick="addToWishList(@Model.Id)" class="heart-icon"><span class="icon_heart_alt"></span></a>
                    <ul>
                       
                        <li>
                            <b>Share on</b>
                            <div class="share">
                                <a href="#"><i class="fa fa-facebook"></i></a>
                                <a href="#"><i class="fa fa-twitter"></i></a>
                                <a href="#"><i class="fa fa-instagram"></i></a>
                                <a href="#"><i class="fa fa-pinterest"></i></a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-12">
                <div class="product__details__tab">
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" data-toggle="tab" href="#tabs-1" role="tab"
                               aria-selected="true">Description</a>
                        </li>
                       
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane active" id="tabs-1" role="tabpanel">
                            <div class="product__details__tab__desc">
                                <h6>Products Infomation</h6>
                                <p>
                                   @Model.Product.Description
                                </p>
                               
                                
                            </div>
                        </div>
                       
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Product Details Section End -->
<!-- Related Product Section Begin -->
<section class="related-product">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title related__product__title">
                    <h2>Related Product</h2>
                </div>
            </div>
        </div>
        <div class="row">
           @foreach (var related in Model.RelatedProducts)
            {
                <div class="col-lg-4 col-md-6 col-sm-6">
                    <div class="product__item">
                        <div class="product__item__pic set-bg" data-setbg="@related.IsMainPicture">
                            <ul class="product__item__pic__hover">
                                <li><a href="javascript:void(0);" onclick="addToWishList(@related.Id)"><i class="fa fa-heart"></i></a></li>
                                <li><a href="javascript:void(0);" onclick="addToBasket(@related.Id)"><i class="fa fa-shopping-cart"></i></a></li>
                            </ul>
                        </div>
                        <div class="product__item__text">
                            <h6><a asp-controller="Home" asp-action="Detail" asp-route-id="@related!.Id">@related?.Name</a></h6>

                            <h5>$@related.Price</h5>
                        </div>
                    </div>
                </div>

            }
        </div>
    </div>
</section>
<!-- Related Product Section End -->