@using Ogani.Business.Dtos.HomeDtos
@model ShopDto 
 
<!-- Product Section Begin -->
    <section class="product spad">
        <div class="container">
            <div class="row">
             
                <div class="col-lg-9 col-md-7">
          
                    <div class="filter__item">
                        <div class="row">
                            <div class="col-lg-4 col-md-5">
                            <form asp-action="Index" method="get" id="sortForm">
                                <input type="hidden" name="search" value="@Context.Request.Query["search"]" />
                                <div class="filter__sort">
                                    <span>Sort By</span>
                                    <select name="sort" onchange="document.getElementById('sortForm').submit()">
                                        @{
                                            var selectedSort = Context.Request.Query["sort"].ToString();
                                        }
                                        <option value="">Default</option>
                                        <option value="az" selected="@(selectedSort == "az")">Name: A to Z</option>
                                        <option value="za" selected="@(selectedSort == "za")">Name: Z to A</option>
                                        <option value="priceLowHigh" selected="@(selectedSort == "priceLowHigh")">Price: Low to High</option>
                                        <option value="priceHighLow" selected="@(selectedSort == "priceHighLow")">Price: High to Low</option>
                                    </select>
                                </div>
                            </form>

                            </div>
                            <div class="col-lg-4 col-md-4">
                                                           </div>
                            <div class="col-lg-4 col-md-3">
                                <div class="filter__option">
                                    <span class="icon_grid-2x2"></span>
                                    <span class="icon_ul"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">

                        @foreach (var product in Model.Products)
                    {
                        <div class="col-lg-4 col-md-6 col-sm-6">
                            <div class="product__item">
                                <div class="product__item__pic set-bg" data-setbg="@product.IsMainPicture">
                                    <ul class="product__item__pic__hover">
                                        <li><a href="javascript:void(0);" onclick="addToWishList(@product.Id)"><i class="fa fa-heart"></i></a></li>
                                        <li><a href="#"><i class="fa fa-retweet"></i></a></li>
                                        <li><a href="javascript:void(0);" onclick="addToBasket(@product.Id)"><i class="fa fa-shopping-cart"></i></a></li>
                                    </ul>
                                </div>
                                <div class="product__item__text">
                                    <h6><a asp-controller="Home" asp-action="Detail" asp-route-id="@product!.Id">@product?.Name</a></h6>

                                    <h5>$@product.Price</h5>
                                </div>
                            </div>
                        </div>
                    }
                        
                      
                    </div>
                   
                </div>
            </div>
        </div>
    </section>
    <!-- Product Section End -->
