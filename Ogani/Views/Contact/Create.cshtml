@using Ogani.Business.Dtos.ContactDtos
@model  ContactCreateDto
<div class="contact-form spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="contact__form__title">
                    <h2>Leave Message</h2>
                </div>
            </div>
        </div>
        <form asp-action="Create" method="post" >
            <div class="row">
                <div class="col-lg-6 col-md-6">
                    <input asp-for="Name" type="text" placeholder="Your name">
                    <span class="validation" asp-validation-for="Name"></span>

                </div>
                <div class="col-lg-6 col-md-6">
                    <input asp-for="Email" type="email" placeholder="Your Email">
                    <span class="validation" asp-validation-for="Email"></span>

                </div>
                <div class="col-lg-12 text-center">
                    <textarea asp-for="Message"  placeholder="Your message"></textarea>
                    <span class="validation" asp-validation-for="Message"></span>

                    <button type="submit" class="site-btn">SEND MESSAGE</button>
                </div>
            </div>
        </form>
    </div>
</div>
