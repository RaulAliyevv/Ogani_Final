@model RegisterDto

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f2f2f2;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .container {
            background: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            width: 350px;
            text-align: center;
        }

        h2 {
            margin-bottom: 20px;
            color: #2d572c; /* Dark green */
        }

        input {
            width: 100%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #4CAF50; /* Green border */
            border-radius: 5px;
            outline: none;
        }

            input:focus {
                border-color: #2d572c;
            }

        button {
            width: 100%;
            padding: 10px;
            background: #4CAF50; /* Green */
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }

            button:hover {
                background: #2d572c;
            }

        .validation {
            color: red;
            font-size: 14px;
            text-align: left;
        }
    </style>
</head>
<body>

    <div class="container">
        <h2>Register</h2>
        <form asp-action="Register" asp-controller="Account" method="post">
            <input asp-for="UserName" type="text" placeholder="Enter your name">
            <span class="validation" asp-validation-for="UserName"></span>

            <input asp-for="NickName" type="text" placeholder="Enter your name">
            <span class="validation" asp-validation-for="NickName"></span>

            <input asp-for="Email" type="email" placeholder="Enter your email">
            <span class="validation" asp-validation-for="Email"></span>

            <input asp-for="Password" type="password" placeholder="Enter your password">
            <span class="validation" asp-validation-for="Password"></span>

            <input asp-for="ConfirmPassword" type="password" placeholder="Enter your ConfirmPassword">
            <span class="validation" asp-validation-for="ConfirmPassword"></span>

            <button type="submit">Sign Up</button>
        </form>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
